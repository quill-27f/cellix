{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini session-start 2>/dev/null || true"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini prompt 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini notify 2>/dev/null || true"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "exit_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini plan 2>/dev/null || true",
            "timeout": 86400000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini tool-done 2>/dev/null || true"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini stop 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cellix hook --agent Gemini session-end 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}