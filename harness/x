#!/usr/bin/env bash
# Task runner. Everything that compiles or runs Rust goes through the guard.
#
#   harness/x check            fmt, clippy, all tests: the gate before every commit
#   harness/x test [args]      cargo test
#   harness/x build [args]     cargo build
#   harness/x run [args]       cargo run -p cellix
#   harness/x snapshot <workspace> <out.png> [review|file] [columns] [rows]
#                              render the real UI to a PNG, with no terminal or window
#   harness/x tour [out]       every surface of the real binary as PNGs, with no window
#   harness/x mux              real tmux and Zellij tests (slower, ignored by check)
#   harness/x tex              papers built by latexmk and pdflatex, with tectonic hidden
#                              (needs TeX Live; ignored by check, run in CI)
#   harness/x perf [baseline]  CPU, bytes and frames of a release build while idle, with a
#                              side-pane shell printing and with tabs printing behind it,
#                              against the last release (PERF_BASELINE, else Homebrew's);
#                              PERF_BUILD=debug measures the debug build, for counts only
#   harness/x verify           check, then prove every passing feature has its test
#   harness/x next             the next unfinished feature
#   harness/x status           machine state, feature counts, recent guarded jobs
#   harness/x bump <version>   set the version everywhere; pushed to main, it releases itself
#   harness/x notes <version>  the release notes CHANGELOG.md gives for a version
#   harness/x reserve-name     publish the crates.io placeholder (needs cargo login)
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1
features=harness/features.json
guard() { label=$1; shift; harness/guard.sh --label "$label" -- "$@"; }

# Tests never use the person's own cache. A Cellix a test starts keeps its sessions there, and
# what it leaves behind (workspaces it had open, programs still held by their hosts) would reach
# the person's own Cellix: 25,000 such folders had built up by 0.11.0. Each run gets a folder
# of its own under /tmp (a socket's path has to fit in about a hundred bytes), and when the run
# ends, any host a test left running there is stopped and the folder removed.
own_cache() {
  cache=$(mktemp -d /tmp/cxc.XXXXXX) || exit 2
  export XDG_CACHE_HOME=$cache
  trap 'pkill -f "session-host $cache/" 2>/dev/null; rm -rf "$cache"' EXIT
}

task=${1:-status}
[ $# -eq 0 ] || shift
case $task in
  check)
    own_cache
    guard check sh -c 'cargo fmt --all --check &&
      cargo clippy --workspace --all-targets -- -D warnings &&
      cargo test --workspace' ;;
  test) own_cache; guard test cargo test --workspace "$@" ;;
  build) guard build cargo build --workspace "$@" ;;
  run)
    guard build cargo build -p cellix || exit $?
    exec target/debug/cellix "$@" ;;
  snapshot) guard snapshot cargo run -q -p cellix --example snapshot -- "$@" ;;
  tour)
    out=${1:-target/tour}
    guard build cargo build -q -p cellix || exit 1
    # The whole tour takes longer than one guarded job may run, so it goes in four parts.
    # TOUR_ONLY=a,b retakes just those scenes, in one.
    if [ -n "${TOUR_ONLY:-}" ]; then
      guard tour python3 -I harness/live/tour.py "$root/target/debug/cellix" "$out"
    else
      status=0
      for part in 1 2 3 4; do
        TOUR_PART=$part/4 harness/guard.sh --label tour -- \
          python3 -I harness/live/tour.py "$root/target/debug/cellix" "$out" || status=$?
      done
      exit $status
    fi ;;
  mux) guard mux cargo test -p cellix --test mux -- --ignored --test-threads=1 "$@" ;;
  tex) guard tex cargo test -p cellix --test tex -- --ignored --test-threads=1 "$@" ;;
  perf)
    # A release build, as people run, measured with nothing else of the guard's running. A
    # debug build's CPU says little, but its counts of wakes, frames and bytes are the same.
    if [ "${PERF_BUILD:-release}" = debug ]; then
      guard build cargo build -q -p cellix || exit $?
      binary=$root/target/debug/cellix
    else
      guard build cargo build -q --release -p cellix || exit $?
      binary=$root/target/release/cellix
    fi
    baseline=${1:-${PERF_BASELINE:-}}
    if [ -z "$baseline" ] && [ -x /opt/homebrew/bin/cellix ]; then baseline=/opt/homebrew/bin/cellix; fi
    guard perf python3 -I harness/live/perf.py "$binary" "$baseline" ;;
  verify)
    # Results come from the gate's own log, and its exit from PIPESTATUS, so nothing that
    # reads this output can turn a failure into a pass.
    # Worktrees share the stamps but not the log, so a verify in one can't rewrite another's
    # results. Each tree that passed keeps its own stamp, so one can't remove another's either.
    state=$(git rev-parse --git-common-dir)/cellix-guard
    mkdir -p "$state/verified.d"
    find "$state/verified.d" -type f -mtime +7 -delete 2>/dev/null
    log=$(git rev-parse --absolute-git-dir)/cellix-verify-run.log
    "$0" check 2>&1 | tee "$log"
    code=${PIPESTATUS[0]}
    [ "$code" = 0 ] || exit "$code"
    missing=0
    unproven=
    for t in $(jq -r '.[] | select(.passes) | .test' "$features"); do
      if grep -Eq "^test ([a-z_0-9]+::)*$t \.\.\. ok$" "$log"; then continue; fi
      if grep -Eq "^test ([a-z_0-9]+::)*$t \.\.\. ignored" "$log"; then
        unproven="$unproven $t"
      else
        echo "did not pass: $t"
        missing=1
      fi
    done
    [ "$missing" = 0 ] || { echo "verify failed: a feature marked passing did not pass"; exit 1; }
    [ -z "$unproven" ] || echo "ignored, so unproven by this run:$unproven"
    # The commit hook compares against this, so only what was really verified can land.
    git config core.hooksPath harness/githooks
    if git diff --quiet; then
      touch "$state/verified.d/$(git write-tree)"
    else
      echo "not stamped: stage your changes before verifying, so what's checked is what lands"
    fi
    echo "verify ok: $(jq '[.[] | select(.passes)] | length' "$features") of $(jq length "$features") features" ;;
  next)
    jq -r '[.[] | select(.passes | not)] | sort_by(.milestone) | first //
      "all features pass" | if type == "object" then "[\(.id)] M\(.milestone): \(.title)\n  test: \(.test)" else . end' "$features" ;;
  status)
    echo "memory free: $(memory_pressure -Q 2>/dev/null | awk '/free percentage/ { print $NF }'), pressure level $(sysctl -n kern.memorystatus_vm_pressure_level 2>/dev/null) (1 normal, 2 warn, 4 critical)"
    echo "swap: $(sysctl -n vm.swapusage 2>/dev/null | cut -d' ' -f1-8)"
    echo "load: $(uptime | sed 's/.*load averages*: //'), disk free: $(df -g . | awk 'NR == 2 { print $4 }') GB, target: $(du -sh target 2>/dev/null | cut -f1)"
    echo "features: $(jq '[.[] | select(.passes)] | length' "$features") of $(jq length "$features") passing"
    log=$(git rev-parse --git-common-dir)/cellix-guard/guard.log
    [ -f "$log" ] && { echo "recent guarded jobs:"; tail -3 "$log"; } ;;
  bump) python3 -I harness/bump.py "$@" ;;
  notes) python3 -I harness/notes.py "$@" ;;
  reserve-name)
    cd harness/reserve-crate && exec ../guard.sh --label reserve -- cargo publish "$@" ;;
  *) sed -n '2,23p' "$0" | sed 's/^# *//'; exit 2 ;;
esac
